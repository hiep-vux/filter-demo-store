{%- liquid
  assign guide_title = section.settings.title | default: 'Try it yourself'
  assign pill_label = section.settings.pill_label | default: guide_title
  assign install_url = section.settings.button_url

  if install_url == blank
    assign install_url = 'https://apps.shopify.com/product-filter-and-search'
  endif
-%}

<button
  type="button"
  class="demo-guide-pill"
  data-demo-guide-pill
  data-demo-action="open-guide"
  aria-controls="globo-aside_demo"
  aria-expanded="false"
>
  <span class="demo-guide-pill__dot" aria-hidden="true"></span>
  <span>{{ pill_label | escape }} · <span data-demo-guide-pill-count>0/0</span></span>
</button>

<div
  class="demo-guide-scrim"
  data-demo-guide-scrim
  data-demo-action="close-guide"
  aria-hidden="true"
></div>

<aside id="globo-aside_demo" class="demo-sidebar" aria-label="{{ guide_title | escape }}">
  <div class="demo-sidebar__header">
    <h2 class="demo-sidebar__title">{{ guide_title | escape }}</h2>
    <button
      type="button"
      class="demo-sidebar__close"
      data-demo-action="close-guide"
      aria-label="{{ section.settings.close_label | default: 'Close guide' | escape }}"
    >
      &times;
    </button>
  </div>

  {%- if section.settings.description != blank -%}
    <div class="demo-sidebar__description rte">{{ section.settings.description }}</div>
  {%- endif -%}

  {%- if section.settings.show_progress -%}
    <div class="demo-progress">
      <div
        class="demo-progress__bar"
        data-demo-progress
        role="progressbar"
        aria-label="{{ section.settings.progress_label | default: 'Guide progress' | escape }}"
        aria-valuemin="0"
        aria-valuemax="0"
        aria-valuenow="0"
      >
        <div class="demo-progress__fill"></div>
      </div>
      <span class="demo-progress__text">0 / 0</span>
    </div>
  {%- endif -%}

  <div class="demo-sections">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          {%- if block.settings.title != blank -%}
            <h3 class="demo-section__title demo-section__title--block" {{ block.shopify_attributes }}>
              {{ block.settings.title | escape }}
            </h3>
          {%- endif -%}

        {%- when 'step' -%}
          {%- liquid
            assign step_id = block.settings.step_id | strip | handleize
            if step_id == blank
              assign step_id = block.id
            endif
          -%}
          <button
            type="button"
            class="demo-card"
            data-demo-step="{{ step_id | escape }}"
            data-demo-step-action="{{ block.settings.action | escape }}"
            {% if block.settings.store != 'all' %}data-demo-store-only="{{ block.settings.store }}"{% endif %}
            aria-pressed="false"
            {{ block.shopify_attributes }}
          >
            <span class="demo-card__icon" aria-hidden="true"><span class="sc-interp"></span></span>
            <span class="demo-card__content">
              <span class="demo-card__title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.description != blank -%}
                <span class="demo-card__description">{{ block.settings.description | escape }}</span>
              {%- endif -%}
            </span>
          </button>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.show_footer -%}
    <div class="demo-footer">
      {%- if section.settings.footer_text != blank -%}
        <div class="demo-footer__text rte">{{ section.settings.footer_text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ install_url }}"
          class="demo-footer__button"
          {% if section.settings.open_new_tab %}target="_blank" rel="noopener"{% endif %}
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</aside>
