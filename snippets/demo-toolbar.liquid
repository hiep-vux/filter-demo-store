<div
    data-dc-tpl="4"
    class="gpf-demo-toolbar"
    data-demo-toolbar
    data-default-layout="sidebar"
    data-default-store="fashion"
    data-default-device="desktop"
>
    <div data-dc-tpl="5" class="gpf-demo-toolbar__brand">
        <img data-dc-tpl="6" class="gpf-demo-toolbar__logo" src="{{ 'app_icon.webp' | asset_url }}" alt="Smart Product Filter &amp; Search" width="24" height="24">
        <span data-dc-tpl="7" class="gpf-demo-toolbar__name">
            Smart Product Filter &amp; Search
        </span>

        <span data-dc-tpl="8" class="gpf-demo-toolbar__badge">
            Horizon theme
        </span>
    </div>

    <div data-dc-tpl="9" class="gpf-demo-toolbar__group">
        <span data-dc-tpl="10" class="gpf-demo-toolbar__label">
            Filter layout
        </span>

        <div data-dc-tpl="11" class="gpf-demo-segmented-control" role="group" aria-label="Filter layout">
            <button type="button" data-dc-tpl="13" data-demo-control="layout" data-demo-value="sidebar" class="gpf-demo-segmented-control__button gpf-demo-segmented-control__button--active" aria-pressed="true">
                <span class="sc-interp">Sidebar</span>
            </button>

            <button type="button" data-dc-tpl="13" data-demo-control="layout" data-demo-value="horizontal" class="gpf-demo-segmented-control__button" aria-pressed="false">
                <span class="sc-interp">Horizontal</span>
            </button>

            <button type="button" data-dc-tpl="13" data-demo-control="layout" data-demo-value="drawer" class="gpf-demo-segmented-control__button" aria-pressed="false">
                <span class="sc-interp">Drawer</span>
            </button>
        </div>
    </div>

    <div data-dc-tpl="14" class="gpf-demo-toolbar__group">
        <span data-dc-tpl="15" class="gpf-demo-toolbar__label">
            Store
        </span>

        <div data-dc-tpl="16" class="gpf-demo-segmented-control" role="group" aria-label="Demo store">
            <button type="button" data-dc-tpl="18" data-demo-control="store" data-demo-value="fashion" class="gpf-demo-segmented-control__button gpf-demo-segmented-control__button--active" aria-pressed="true">
                <span class="sc-interp">Fashion</span>
            </button>

            <button type="button" data-dc-tpl="18" data-demo-control="store" data-demo-value="auto" class="gpf-demo-segmented-control__button" aria-pressed="false">
                <span class="sc-interp">Auto parts</span>
            </button>
        </div>
    </div>

    <div data-dc-tpl="19" class="gpf-demo-toolbar__group">
        <div data-dc-tpl="20" class="gpf-demo-segmented-control" role="group" aria-label="Preview device">
            <button type="button" data-dc-tpl="22" data-demo-control="device" data-demo-value="desktop" class="gpf-demo-segmented-control__button gpf-demo-segmented-control__button--active" aria-pressed="true">
                <span class="sc-interp">Desktop</span>
            </button>

            <button type="button" data-dc-tpl="22" data-demo-control="device" data-demo-value="mobile" class="gpf-demo-segmented-control__button" aria-pressed="false">
                <span class="sc-interp">Mobile</span>
            </button>
        </div>
    </div>

    <div data-dc-tpl="23" class="gpf-demo-toolbar__actions">
        <button type="button" data-dc-tpl="24" data-demo-action="reset" class="scp0 gpf-demo-button gpf-demo-button--outline">
            Reset demo
        </button>

        <button type="button" data-dc-tpl="25" data-demo-action="toggle-guide" class="scp1 gpf-demo-button gpf-demo-button--dark" aria-controls="gpf-demo-guide" aria-expanded="true">
            <span class="sc-interp" data-demo-guide-label>Hide guide</span>
        </button>

        <a
            data-dc-tpl="26"
            href="https://apps.shopify.com/product-filter-and-search"
            target="_blank"
            class="scp2 gpf-demo-button gpf-demo-button--primary"
        >
            Start free trial
        </a>
    </div>
</div>
