<div data-dc-tpl="4" class="demo-toolbar">
    <div data-dc-tpl="5" class="demo-toolbar__brand">
        <img data-dc-tpl="6"  class="demo-toolbar__logo" src="{{ 'app_icon.webp' | asset_url }}" alt="Smart Product Filter &amp; Search" >
        <span data-dc-tpl="7" class="demo-toolbar__name">
            Smart Product Filter &amp; Search
        </span>

        <span data-dc-tpl="8" class="demo-toolbar__badge">
            Horizon theme
        </span>
    </div>

    <div data-dc-tpl="9" class="demo-toolbar__group">
        <span data-dc-tpl="10" class="demo-toolbar__label">
            Filter layout
        </span>

        <div data-dc-tpl="11" class="demo-segment">
            <button data-dc-tpl="13" class="demo-segment__button demo-segment__button--active">
                <span class="sc-interp">Sidebar</span>
            </button>

            <button data-dc-tpl="13" class="demo-segment__button">
                <span class="sc-interp">Horizontal</span>
            </button>

            <button data-dc-tpl="13" class="demo-segment__button">
                <span class="sc-interp">Drawer</span>
            </button>
        </div>
    </div>

    <div data-dc-tpl="14" class="demo-toolbar__group">
        <span data-dc-tpl="15" class="demo-toolbar__label">
            Store
        </span>

        <div data-dc-tpl="16" class="demo-segment">
            <button data-dc-tpl="18" class="demo-segment__button">
                <span class="sc-interp">Fashion</span>
            </button>

            <button data-dc-tpl="18" class="demo-segment__button demo-segment__button--active">
                <span class="sc-interp">Auto parts</span>
            </button>
        </div>
    </div>

    <div data-dc-tpl="19" class="demo-toolbar__group">
        <div data-dc-tpl="20" class="demo-segment">
            <button data-dc-tpl="22" class="demo-segment__button demo-segment__button--active">
                <span class="sc-interp">Desktop</span>
            </button>

            <button data-dc-tpl="22" class="demo-segment__button">
                <span class="sc-interp">Mobile</span>
            </button>
        </div>
    </div>

    <div data-dc-tpl="23" class="demo-toolbar__actions">
        <button data-dc-tpl="24" class="scp0 demo-button demo-button--outline">
            Reset demo
        </button>

        <button data-dc-tpl="25" class="scp1 demo-button demo-button--dark">
            <span class="sc-interp">Hide guide</span>
        </button>

        <a
            data-dc-tpl="26"
            href="https://apps.shopify.com/product-filter-and-search"
            target="_blank"
            class="scp2 demo-button demo-button--primary"
        >
            Start free trial
        </a>
    </div>
</div>