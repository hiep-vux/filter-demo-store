{% comment %} {% schema %}
{
  "name": "Demo Footer",
  "tag": "section",
  "class": "section-demo-footer",
  "settings": [
    {
      "type": "textarea",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Demo storefront for Smart Product Filter & Search by Globo.io · Horizon theme"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Link text",
          "default": "User guide"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open in new tab",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Demo Footer",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "User guide"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "App listing"
          }
        }
      ]
    }
  ]
}
{% endschema %} {% endcomment %}